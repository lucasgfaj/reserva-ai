{
  "version": 2,
  "buildCommand": "npx prisma generate && npx nest build",
  "outputDirectory": "dist",
  "functions": {
    "src/main.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "/api/v1/(.*)", "dest": "src/main.js" },
    { "src": "/api/v1", "dest": "src/main.js" }
  ]
}
