    "/api/v1/auth/register": {
      "post": {
        "description": "\n      **[US01]** Cria de forma atômica o condomínio e o usuário administrador raiz (Self-Service Onboarding).\n      \n      **Acesso:** Público (não requer autenticação)\n      **Regras de negócio:** RN02\n      \n      **Exemplo de cURL:**\n      ```bash\n      curl -X POST http://localhost:3000/api/v1/auth/register \\\n        -H \"Content-Type: application/json\" \\\n        -c cookies.txt \\\n        -d '{\n          \"adminName\": \"Lucas Admin\",\n          \"adminEmail\": \"admin@reservaai.com.br\",\n          \"adminPassword\": \"SenhaSegura123!\",\n          \"condominiumName\": \"Residencial Horizonte\",\n          \"condominiumAddress\": \"Rua das Flores, 123\"\n        }'\n      ```\n    ",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterTenantDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Condomínio e Admin criados com sucesso. Cookie HttpOnly definido."
          },
          "400": {
            "description": "Dados de entrada inválidos."
          },
          "409": {
            "description": "E-mail já cadastrado."
          }
        },
        "summary": "US01 - Registrar condomínio e administrador raiz",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
