  "info": {
    "title": "🚀 Reserva Aí! - API de Gestão de Condomínios",
    "description": "## 📝 Sobre o Projeto\nO **Reserva Aí!** é uma solução completa para a modernização da gestão de condomínios.\n\n### 🛠️ Guia de Uso\n1. **Autenticação:** Após login, use o token JWT no header Authorization: `Bearer <token>`\n2. **Isolamento (Multi-tenant):** Dados isolados por condomínio (RN01)\n3. **Roles:** ADMIN (administrador), RESIDENT (morador), SUPER_ADMIN\n\n### 🔐 Segurança e Permissões\n| Role | Acesso |\n|------|--------|\n| ADMIN | CRUD completo: condomínio, moradores e áreas |\n| RESIDENT | READ: áreas comuns; BOOK: reservas |\n| SUPER_ADMIN | Global (sem condomínio vinculado) |\n\n### 📋 User Stories Implementadas\n| US | Descrição |\n|----|----------|\n| US01 | Criar conta e registrar condomínio |\n| US02 | Login e gerenciar dados do condomínio |\n| US03 | Cadastrar e gerenciar moradores (Admin) |\n| US03.1 | Login de morador |\n| US04 | Cadastrar e gerenciar áreas comuns (Admin) |\n| US05 | Visualizar áreas comuns |\n| US06 | Consultar disponibilidade de áreas comuns |\n| US07 | Realizar reserva de área comum |\n| US08 | Cancelar reserva |\n| US09/US10 | Listar reservas (Admin e Morador) |\n| US11 | Aprovar/Rejeitar reserva (Admin) |\n| - | Comunicados (Admin criar/remover, todos visualizar) |\n\n*Desenvolvido em NestJS + Prisma ORM + PostgreSQL*",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "US01, US02, US03.1 - Autenticação e Registro"
    },
    {
      "name": "residents",
      "description": "US03 - Gestão de Moradores (Admin only)"
    },
    {
      "name": "condominiums",
      "description": "US02 - Gestão do Condomínio"
    },
    {
      "name": "common-areas",
      "description": "US04, US05, US06 - Áreas Comuns"
    },
    {
      "name": "reservations",
      "description": "US07, US08, US09, US10, US11 - Reservas"
    },
    {
      "name": "announcements",
      "description": "Comunicados do Condomínio"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Cole o token JWT retornado no login",
        "in": "header"
      }
    },
    "schemas": {
      "RegisterTenantDto": {
        "type": "object",
        "properties": {
          "condominiumName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150,
            "example": "Residencial Horizonte",
            "description": "Nome do condomínio (Mapeado para Condominium.name - VARCHAR 150)"
          },
          "condominiumAddress": {
            "type": "string",
            "maxLength": 255,
            "example": "Rua das Flores, 123",
            "description": "Endereço completo (Mapeado para Condominium.address - VARCHAR 255)"
          },
          "adminName": {
            "type": "string",
            "maxLength": 120,
            "example": "Lucas Admin",
            "description": "Nome completo do administrador (Mapeado para User.name - VARCHAR 120)"
          },
          "adminEmail": {
            "type": "string",
            "format": "email",
            "example": "admin@reservaai.com.br",
            "description": "E-mail para login (Mapeado para User.email - VARCHAR 150 - Único)"
          },
          "adminPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 40,
            "pattern": "^(?=.*[a-zA-Z])(?=.*[0-9])(?=.*[^a-zA-Z0-9])",
            "example": "SenhaSegura123!@",
            "description": "Senha que será hasheada via Bcrypt (mín 8 chars, letra, número e qualquer especial)"
          }
        },
        "required": [
          "condominiumName",
          "condominiumAddress",
          "adminName",
          "adminEmail",
          "adminPassword"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@reservaai.com.br",
            "description": "E-mail do usuário cadastrado"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "Senha123!",
            "description": "Senha do usuário"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "João Silva",
            "description": "Nome do usuário"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "joao@email.com",
            "description": "E-mail do usuário"
          }
        }
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "SenhaAtual123!",
            "description": "Senha atual do usuário"
          },
          "newPassword": {
            "type": "string",
            "minLength": 6,
            "example": "NovaSenha456!",
            "description": "Nova senha"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "UpdatePermissionsDto": {
        "type": "object",
        "properties": {
          "canBook": {
            "type": "boolean",
            "example": false,
            "description": "Indica se o morador pode realizar reservas"
          }
        },
        "required": [
          "canBook"
        ]
      },
      "CreateResidentDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "example": "João Morador",
            "description": "Nome completo do morador (3-120 caracteres)"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "joao@reservaai.com.br",
            "description": "E-mail único para login do morador"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 40,
            "pattern": "^(?=.*[a-zA-Z])(?=.*[0-9])",
            "example": "Test1234",
            "description": "Senha opcional. Se não fornecida, será gerada automaticamente (8 caracteres)"
          },
          "unitId": {
            "type": "string",
            "format": "uuid",
            "example": "uuid-da-unidade",
            "description": "UUID da unidade residencial (opcional)"
          },
          "document": {
            "type": "string",
            "maxLength": 20,
            "example": "12345678901",
            "description": "Documento do morador (CPF/RG)"
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "example": "11999999999",
            "description": "Telefone de contato do morador"
          },
          "canBook": {
            "type": "boolean",
            "example": true,
            "description": "Indica se o morador pode realizar reservas (padrão: true)"
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "CreateCommonAreaDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "example": "Salão de Festas",
            "description": "Nome da área comum (2-120 caracteres)"
          },
          "description": {
            "type": "string",
            "example": "Espaço para eventos",
            "description": "Descrição da área comum"
          },
          "capacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000,
            "example": 50,
            "description": "Capacidade máxima (0-10000)"
          },
          "openTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$",
            "example": "08:00",
            "description": "Horário de abertura (HH:MM)"
          },
          "closeTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$",
            "example": "22:00",
            "description": "Horário de fechamento (HH:MM)"
          },
          "operatingDays": {
            "type": "string",
            "pattern": "^(\\d+,)*\\d+$",
            "example": "1,2,3,4,5,6,7",
            "description": "Dias de funcionamento (1=Domingo a 7=Sábado)"
          },
          "requiresApproval": {
            "type": "boolean",
            "example": true,
            "description": "Indica se requer aprovação do administrador"
          },
          "icon": {
            "type": "string",
            "example": "pool",
            "description": "Ícone (Material Symbol) para representar a área"
          },
          "isUnderMaintenance": {
            "type": "boolean",
            "example": false,
            "description": "Indica se a área está em manutenção"
          }
        },
        "required": [
          "name",
          "openTime",
          "closeTime"
        ]
      },
      "UpdateCommonAreaDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "example": "Salão de Festas Premium",
            "description": "Nome da área comum (2-120 caracteres)"
          },
          "description": {
            "type": "string",
            "example": "Espaço para eventos",
            "description": "Descrição da área comum"
          },
          "capacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000,
            "example": 100,
            "description": "Capacidade máxima (0-10000)"
          },
          "openTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$",
            "example": "09:00",
            "description": "Horário de abertura (HH:MM)"
          },
          "closeTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$",
            "example": "23:00",
            "description": "Horário de fechamento (HH:MM)"
          },
          "operatingDays": {
            "type": "string",
            "pattern": "^(\\d+,)*\\d+$",
            "example": "1,2,3,4,5,6,7",
            "description": "Dias de funcionamento (1=Domingo a 7=Sábado)"
          },
          "requiresApproval": {
            "type": "boolean",
            "example": true,
            "description": "Indica se requer aprovação do administrador"
          },
          "icon": {
            "type": "string",
            "example": "pool",
            "description": "Ícone (Material Symbol) para representar a área"
          },
          "isUnderMaintenance": {
            "type": "boolean",
            "example": false,
            "description": "Indica se a área está em manutenção"
          }
        }
      },
      "AddClosedDateDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2026-12-25",
            "description": "Data a ser fechada (YYYY-MM-DD)"
          }
        },
        "required": [
          "date"
        ]
      },
      "RemoveClosedDateDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2026-12-25",
            "description": "Data a ser reaberta (YYYY-MM-DD)"
          }
        },
        "required": [
          "date"
        ]
      },
      "CreateReservationDto": {
        "type": "object",
        "properties": {
          "commonAreaId": {
            "type": "string",
            "description": "UUID da área comum"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Data da reserva (YYYY-MM-DD)",
            "example": "2026-07-15"
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$",
            "description": "Horário de início (HH:MM)",
            "example": "10:00"
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):([0-5]\\d)$",
            "description": "Horário de fim (HH:MM)",
            "example": "12:00"
          },
          "notes": {
            "type": "string",
            "description": "Observações"
          },
          "residentId": {
            "type": "string",
            "description": "UUID do morador (apenas admin)"
          }
        },
        "required": [
          "commonAreaId",
          "date",
          "startTime",
          "endTime"
        ]
      },
      "UpdateCondominiumDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150,
            "description": "Nome do condomínio",
            "example": "Residencial Horizonte"
          },
          "address": {
            "type": "string",
            "minLength": 5,
            "maxLength": 255,
            "description": "Endereço do condomínio",
            "example": "Rua das Flores, 123"
          },
          "timezone": {
            "type": "string",
            "description": "Fuso horário do condomínio",
            "example": "America/Sao_Paulo"
          }
        }
      },
      "CreateAnnouncementDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "example": "Manutenção na Piscina",
            "description": "Título do comunicado"
          },
          "content": {
            "type": "string",
            "example": "A piscina estará fechada para manutenção no dia 25/12.",
            "description": "Conteúdo do comunicado"
          }
        },
        "required": [
          "title",
          "content"
        ]
      }
    }
  }
}