    "/api/v1/auth/register": {
      "post": {
        "description": "\n      **[US01]** Cria de forma atômica o condomínio e o usuário administrador raiz (Self-Service Onboarding).\n      \n      **Acesso:** Público (não requer autenticação)\n      **Regras de negócio:** RN02\n      \n      **Exemplo de cURL:**\n      ```bash\n      curl -X POST http://localhost:3000/api/v1/auth/register \\\n        -H \"Content-Type: application/json\" \\\n        -c cookies.txt \\\n        -d '{\n          \"adminName\": \"Lucas Admin\",\n          \"adminEmail\": \"admin@reservaai.com.br\",\n          \"adminPassword\": \"SenhaSegura123!\",\n          \"condominiumName\": \"Residencial Horizonte\",\n          \"condominiumAddress\": \"Rua das Flores, 123\"\n        }'\n      ```\n    ",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterTenantDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Condomínio e Admin criados com sucesso. Cookie HttpOnly definido."
          },
          "400": {
            "description": "Dados de entrada inválidos."
          },
          "409": {
            "description": "E-mail já cadastrado."
          }
        },
        "summary": "US01 - Registrar condomínio e administrador raiz",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "\n      **[US02]** Login de administrador para gerenciar dados do condomínio.\n      **[US03.1]** Login de morador com credenciais fornecidas pelo administrador.\n      \n      **Acesso:** Público (não requer autenticação)\n      \n      **Exemplo de cURL (com cookies):**\n      ```bash\n      curl -X POST http://localhost:3000/api/v1/auth/login \\\n        -H \"Content-Type: application/json\" \\\n        -c cookies.txt \\\n        -d '{\"email\": \"admin@reservaai.com.br\", \"password\": \"SenhaSegura123!\"}'\n      ```\n    ",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso."
          },
          "401": {
            "description": "Credenciais inválidas."
          }
        },
        "summary": "US02/US03.1 - Login de administrador ou morador",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "\n      Invalida a sessão do usuário limpando o cookie HttpOnly.\n      \n      **Acesso:** Autenticado (requer JWT)\n      \n      **Exemplo de cURL:**\n      ```bash\n      curl -X POST http://localhost:3000/api/v1/auth/logout \\\n        -b cookies.txt \\\n        -c cookies.txt\n      ```\n    ",
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Logout realizado com sucesso. Cookie limpo."
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Logout - Invalidar sessão",
        "tags": [
          "auth"
        ]
      }
    },
