  "info": {
    "title": "🚀 Reserva Aí! - API de Gestão de Condomínios",
    "description": "## 📝 Sobre o Projeto\nO **Reserva Aí!** é uma solução completa para a modernização da gestão de condomínios.\n\n### 🛠️ Guia de Uso\n1. **Autenticação:** Após login, use o token JWT no header Authorization: `Bearer <token>`\n2. **Isolamento (Multi-tenant):** Dados isolados por condomínio (RN01)\n3. **Roles:** ADMIN (administrador), RESIDENT (morador), SUPER_ADMIN\n\n### 🔐 Segurança e Permissões\n| Role | Acesso |\n|------|--------|\n| ADMIN | CRUD completo: condomínio, moradores e áreas |\n| RESIDENT | READ: áreas comuns; BOOK: reservas |\n| SUPER_ADMIN | Global (sem condomínio vinculado) |\n\n### 📋 User Stories Implementadas\n| US | Descrição |\n|----|----------|\n| US01 | Criar conta e registrar condomínio |\n| US02 | Login e gerenciar dados do condomínio |\n| US03 | Cadastrar moradores (Admin) |\n| US03.1 | Login de morador |\n| US04 | Cadastrar e gerenciar áreas comuns (Admin) |\n| US05 | Visualizar áreas comuns |\n| US06 | Consultar disponibilidade de áreas comuns |\n\n*Desenvolvido em NestJS + Prisma ORM + PostgreSQL (Neon.tech)*",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "US01, US02, US03.1 - Autenticação e Registro"
    },
    {
      "name": "residents",
      "description": "US03 - Gestão de Moradores (Admin only)"
    },
    {
      "name": "common-areas",
      "description": "US04, US05, US06 - Áreas Comuns"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Cole o token JWT retornado no login",
        "in": "header"
      }
    },
    "schemas": {
      "RegisterTenantDto": {
        "type": "object",
        "properties": {
          "condominiumName": {
            "type": "string",
            "example": "Residencial Horizonte",
            "description": "Nome do condomínio (Mapeado para Condominium.name - VARCHAR 150)"
          },
          "condominiumAddress": {
            "type": "string",
            "example": "Rua das Flores, 123",
            "description": "Endereço completo (Mapeado para Condominium.address - VARCHAR 255)"
          },
          "adminName": {
            "type": "string",
            "example": "Lucas Admin",
            "description": "Nome completo do administrador (Mapeado para User.name - VARCHAR 120)"
          },
          "adminEmail": {
            "type": "string",
            "example": "admin@reservaai.com.br",
            "description": "E-mail para login (Mapeado para User.email - VARCHAR 150 - Único)"
          },
          "adminPassword": {
            "type": "string",
            "example": "SenhaSegura123!@",
            "description": "Senha que será hasheada via Bcrypt (mín 8 chars, letra, número e qualquer especial)",
            "minLength": 8
          }
        },
        "required": [
          "condominiumName",
          "condominiumAddress",
          "adminName",
          "adminEmail",
          "adminPassword"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@reservaai.com.br",
            "description": "E-mail do usuário cadastrado"
          },
          "password": {
            "type": "string",
            "example": "Senha123!",
            "description": "Senha do usuário",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UpdatePermissionsDto": {
        "type": "object",
        "properties": {
          "canBook": {
            "type": "boolean",
            "example": false,
            "description": "Indica se o morador pode realizar reservas"
          }
        },
        "required": [
          "canBook"
        ]
      },
      "CreateResidentDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "João Morador",
            "description": "Nome completo do morador (3-120 caracteres)"
          },
          "email": {
            "type": "string",
            "example": "joao@reservaai.com.br",
            "description": "E-mail único para login do morador"
          },
          "password": {
            "type": "string",
            "example": "Test1234",
            "description": "Senha opcional. Se não fornecida, será gerada automaticamente (8 caracteres)",
            "minLength": 8
          },
          "unitId": {
            "type": "string",
            "example": "uuid-da-unidade",
            "description": "UUID da unidade residencial (opcional)"
          },
          "document": {
            "type": "string",
            "example": "12345678901",
            "description": "Documento do morador (CPF/RG)"
          },
          "phone": {
            "type": "string",
            "example": "11999999999",
            "description": "Telefone de contato do morador"
          },
          "canBook": {
            "type": "boolean",
            "example": true,
