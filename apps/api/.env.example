# Local Development Database (Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reserva_ai_db?schema=public"

# Neon Database (Production/Staging)
# Create your project at https://console.neon.tech and paste the URL here
# DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-key-change-this

# CORS - comma-separated origins allowed
CORS_ORIGIN="https://<sua.url>.vercel.app"

# Port
PORT=3000
