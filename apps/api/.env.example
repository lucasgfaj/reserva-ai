# Neon Database (Production) — usar pooler para produção
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reserva_ai_db?schema=public"
# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-key-change-this
# CORS - comma-separated origins allowed
CORS_ORIGIN="https://<your-web-app>.vercel.app"
# Port
PORT=3000
