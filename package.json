{
    "name": "reserva-ai",
    "version": "1.0.0",
    "description": "Monorepo do projeto da disciplina",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev:prisma": "npm run prisma:generate -w apps/api && npm run prisma:deploy -w apps/api",
        "dev:api": "npm run start:dev -w apps/api",
        "dev:api:test": "npm run test -w apps/api",
        "dev:api:test:cover": "npm run test --workspace apps/api -- --coverage",
        "dev:api:test:e2e": "export DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/reserva_ai_db?schema=public\" && npm run test:e2e -w apps/api",
        "dev:web": "npm run dev -w apps/web"
    },
    "keywords": [
        "nestjs",
        "vuejs",
        "monorepo"
    ],
    "author": "Special Topics in Software Engineering",
    "license": "UNLICENSED"
}